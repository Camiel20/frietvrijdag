rules_version = '2';

// FrietVrijdag — plak dit in Firebase-console → Firestore → Regels → Publiceren.
//
// Wie is wie:
//  - Collega: opent zijn eigen link (#t=<token>). De pagina logt onzichtbaar anoniem in en legt
//    koppelingen/{uid} = {token, deelnemer} vast. Dat mag alleen met een token die bestaat.
//    Daarna weten de regels via de koppeling wie het is, zonder dat de token ergens leesbaar staat.
//    Nieuwe link (oude token weg) of uitzetten = de koppeling werkt meteen niet meer.
//  - Beheerder: ingelogd met Google én er bestaat beheer/{uid} (alleen via de console aan te maken).
//
// Collecties:
//  deelnemers/{id}                    {naam, actief}                 lezen: collega's; schrijven: beheerder
//  tokens/{token}                     {deelnemer}                    alleen ophalen als je de token kent
//  koppelingen/{uid}                  {token, deelnemer}
//  rondes/{vrijdag}                   {datum, open, geopendDoor, betaler, gedraaidDoor, gedraaidOp, tikkie, bonTekst, bonTotaal, notities}
//  rondes/{vrijdag}/bestellingen/{deelnemer}   {regels, betaald, ontvangen, bijgewerkt}
service cloud.firestore {
  match /databases/{database}/documents {

    function ingelogd() { return request.auth != null; }
    function isBeheerder() {
      return ingelogd() && exists(/databases/$(database)/documents/beheer/$(request.auth.uid));
    }
    function koppeling() {
      return get(/databases/$(database)/documents/koppelingen/$(request.auth.uid)).data;
    }
    function isDeelnemer() {
      return ingelogd()
        && exists(/databases/$(database)/documents/koppelingen/$(request.auth.uid))
        && exists(/databases/$(database)/documents/tokens/$(koppeling().token))
        && get(/databases/$(database)/documents/deelnemers/$(koppeling().deelnemer)).data.actief == true;
    }
    function ik() { return koppeling().deelnemer; }
    function nieuw() { return request.resource.data; }
    function gewijzigd() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /beheer/{uid} {
      allow get: if ingelogd() && request.auth.uid == uid;
    }

    match /deelnemers/{id} {
      allow read: if isBeheerder() || isDeelnemer();
      allow write: if isBeheerder();
    }

    match /tokens/{token} {
      allow get: if ingelogd();
      allow list, write: if isBeheerder();
    }

    match /koppelingen/{uid} {
      allow get: if ingelogd() && (request.auth.uid == uid || isBeheerder());
      allow create, update: if ingelogd() && request.auth.uid == uid
        && nieuw().keys().hasOnly(['token', 'deelnemer'])
        && nieuw().token is string
        && exists(/databases/$(database)/documents/tokens/$(nieuw().token))
        && get(/databases/$(database)/documents/tokens/$(nieuw().token)).data.deelnemer == nieuw().deelnemer;
    }

    match /rondes/{datum} {
      // Eén ronde per vrijdag: het document-ID ís de datum. Openen mag een collega alleen
      // voor een vrijdag van ongeveer deze week (niet ver vooruit of terug).
      function isDezeVrijdag() {
        let p = datum.split('-');
        let dag = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
        return dag.dayOfWeek() == 5
          && dag > request.time - duration.value(2, 'd')
          && dag < request.time + duration.value(8, 'd');
      }
      function bestellingVan(id) {
        return get(/databases/$(database)/documents/rondes/$(datum)/bestellingen/$(id)).data;
      }
      // Draaien aan het rad: één keer, door iemand die besteld heeft; het rad kiest iemand die besteld heeft.
      function draaien() {
        return resource.data.betaler == null
          && gewijzigd().hasOnly(['betaler', 'gedraaidDoor', 'gedraaidOp', 'open'])
          && nieuw().open == false
          && nieuw().gedraaidDoor == ik()
          && nieuw().gedraaidOp == request.time
          && nieuw().betaler is string
          && exists(/databases/$(database)/documents/rondes/$(datum)/bestellingen/$(nieuw().betaler))
          && bestellingVan(nieuw().betaler).regels.size() > 0
          && exists(/databases/$(database)/documents/rondes/$(datum)/bestellingen/$(ik()));
      }
      // Alleen wie de rekening betaalt, zet de betaallink en de bon.
      function betalerZet() {
        return resource.data.betaler == ik()
          && gewijzigd().hasOnly(['tikkie', 'bonTekst', 'bonTotaal'])
          && nieuw().tikkie is string && nieuw().tikkie.size() <= 300
          && (nieuw().tikkie == '' || nieuw().tikkie.matches('https://[^ ]+'))
          && nieuw().bonTekst is string && nieuw().bonTekst.size() <= 20000
          && (nieuw().bonTotaal == null || nieuw().bonTotaal is int);
      }

      allow get: if isBeheerder() || isDeelnemer();
      allow list, delete: if isBeheerder();
      allow create: if isBeheerder() || (isDeelnemer()
        && datum.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isDezeVrijdag()
        && nieuw().keys().hasOnly(['datum', 'open', 'geopendDoor', 'betaler', 'tikkie', 'bonTekst', 'bonTotaal', 'notities'])
        && nieuw().datum == datum && nieuw().open == true && nieuw().geopendDoor == ik()
        && nieuw().betaler == null && nieuw().tikkie == '' && nieuw().bonTekst == ''
        && nieuw().bonTotaal == null && nieuw().notities == '');
      allow update: if isBeheerder() || (isDeelnemer() && (draaien() || betalerZet()));

      match /bestellingen/{id} {
        function ronde() { return get(/databases/$(database)/documents/rondes/$(datum)).data; }
        function regelsGoed() { return nieuw().regels is list && nieuw().regels.size() <= 30; }

        allow read: if isBeheerder() || isDeelnemer();
        allow delete: if isBeheerder();
        allow create: if isBeheerder() || (isDeelnemer() && id == ik() && ronde().open == true
          && nieuw().keys().hasOnly(['regels', 'bijgewerkt']) && regelsGoed());
        allow update: if isBeheerder() || (isDeelnemer() && (
          // eigen bestelling aanpassen zolang de ronde open is
          (id == ik() && ronde().open == true && gewijzigd().hasOnly(['regels', 'bijgewerkt']) && regelsGoed())
          // "ik heb betaald" — ook na het sluiten
          || (id == ik() && gewijzigd().hasOnly(['betaald']) && nieuw().betaald is bool)
          // de betaler bevestigt dat het geld binnen is
          || (ronde().betaler == ik() && id != ik() && gewijzigd().hasOnly(['ontvangen']) && nieuw().ontvangen is bool)
        ));
      }
    }
  }
}
